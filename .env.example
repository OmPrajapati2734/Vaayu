# AeroSense AI (Vaayu) Environment Configuration
# All sensitive keys are loaded via environment variables in accordance with OWASP security guidelines.

# Optional: Real-world Google Gemini API Key for direct cloud LLM inference
# If omitted, the built-in offline multi-tool autonomous agent executes seamlessly.
VITE_GEMINI_API_KEY=

# Optional: Custom Air Quality API endpoint (defaults to public open-meteo / sensor feeds)
VITE_AQI_API_ENDPOINT=https://air-quality-api.open-meteo.com/v1/air-quality

